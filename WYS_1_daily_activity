)

# B. Interspecific comparisons in warm season
warm_tasks <- list(
  list(name = "Warm_Ela_vs_Munt", rad1 = model_ela_w$solar, rad2 = model_munt_w$solar),
  list(name = "Warm_Ela_vs_Sus",  rad1 = model_ela_w$solar, rad2 = model_sus_w$solar),
  list(name = "Warm_Ela_vs_Cap",  rad1 = model_ela_w$solar, rad2 = model_cap_w$solar),
  list(name = "Warm_Munt_vs_Sus", rad1 = model_munt_w$solar, rad2 = model_sus_w$solar),
  list(name = "Warm_Munt_vs_Cap", rad1 = model_munt_w$solar, rad2 = model_cap_w$solar),
  list(name = "Warm_Sus_vs_Cap",  rad1 = model_sus_w$solar, rad2 = model_cap_w$solar)
)

# C. Interspecific comparisons in cold season
cold_tasks <- list(
  list(name = "Cold_Ela_vs_Munt", rad1 = model_ela_c$solar, rad2 = model_munt_c$solar),
  list(name = "Cold_Ela_vs_Sus",  rad1 = model_ela_c$solar, rad2 = model_sus_c$solar),
  list(name = "Cold_Ela_vs_Cap",  rad1 = model_ela_c$solar, rad2 = model_cap_c$solar),
