# Diel Activity Pattern Plotting
```{r}
plot_perfect_curve <- function(model, species_name = "") {
  # 1. Extract underlying data and convert x-axis to hours
  x_raw <- model@pdf[, 1] * 24 / (2 * pi)
  y_density <- model@pdf[, 2]
  
  # Check if model includes bootstrapped confidence intervals (prevents error if reps parameter was omitted)
  has_ci <- ncol(model@pdf) >= 5
  if(has_ci) {
    y_lower <- model@pdf[, 4]
    y_upper <- model@pdf[, 5]
  }
  
  # 2. Strictly sort x-axis values (crucial step to resolve line artifacts/discontinuities)
  order_idx <- order(x_raw)
  x_sorted <- x_raw[order_idx]
  y_den_sorted <- y_density[order_idx]
  
  if(has_ci) {
    y_low_sorted <- y_lower[order_idx]
    y_up_sorted <- y_upper[order_idx]
    y_max <- max(y_up_sorted, na.rm = TRUE)
  } else {
    y_max <- max(y_den_sorted, na.rm = TRUE)
  }
  
  # 3. Plot continuous primary curve using base graphics engine
  plot(x_sorted, y_den_sorted, type = "l", col = "black", lty = 1, lwd = 1.5,
       xaxt = "n", ylab = "Density", xlab = "Time", main = species_name,
       xlim = c(0, 24), ylim = c(0, y_max))
  
  # 4. Overlay confidence interval dashed lines
  if(has_ci) {
    lines(x_sorted, y_low_sorted, col = "black", lty = 3)
    lines(x_sorted, y_up_sorted, col = "black", lty = 3)
  }
  
  # 5. Add custom x-axis time ticks at the bottom
  axis(side = 1, at = c(0, 6, 12, 18, 24), labels = c("0", "6:00", "12:00", "18:00", "24:00"))
}

