# Batch Calculate 95% Confidence Intervals for Comparisons Above
```{r}
library(overlap)
library(dplyr)
library(purrr) # For efficient batch iteration and mapping

# ==========================================
# Step 1: Define an efficient wrapper function to calculate overlap and CI
# ==========================================
calc_overlap_ci <- function(rad1, rad2, pair_name, reps = 1000) {
  
  # 1. Obtain sample sizes
  n1 <- length(rad1[!is.na(rad1)])
  n2 <- length(rad2[!is.na(rad2)])
  
  # 2. Automatically select estimator based on sample size (Dhat4 for n >= 50, Dhat1 for n < 50)
  est_type <- ifelse(min(n1, n2) >= 50, "Dhat4", "Dhat1")
  
  # 3. Calculate observed overlap coefficient (Delta)
  obs <- overlapEst(rad1, rad2, type = est_type)
  
  # 4. Run bootstrap (set random seed for reproducibility)
  set.seed(123)
  boot_res <- bootstrap(rad1, rad2, nb = reps, type = est_type)
  
  # 5. Extract norm0 confidence intervals
  ci <- bootCI(obs, boot_res)
  
  # 6. Return a tidy data frame row
  return(data.frame(
    Comparison = pair_name,
    Delta = as.numeric(obs),
    CI_Lower = ci["norm0", "lower"],
    CI_Upper = ci["norm0", "upper"],
    Estimator = est_type,
    Sample_Size_1 = n1,
    Sample_Size_2 = n2,
    stringsAsFactors = FALSE
  ))
}

# ==========================================
# Step 2: Build comparison task list
# Note: $solar from the fitted solartime models contains the required radian data
# ==========================================

# A. Seasonal comparisons within species
season_tasks <- list(
  list(name = "TuftedDeer_Warm_vs_Cold", rad1 = model_ela_w$solar, rad2 = model_ela_c$solar),
  list(name = "Muntjac_Warm_vs_Cold",    rad1 = model_munt_w$solar, rad2 = model_munt_c$solar),
