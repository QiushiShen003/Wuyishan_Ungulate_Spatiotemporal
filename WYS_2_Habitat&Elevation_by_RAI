classify_elevation <- function(elevation) {
  case_when(
    elevation < 400 ~ "<400m",
    elevation >= 400 & elevation < 600 ~ "400-600m",
    elevation >= 600 & elevation < 800 ~ "600-800m",
    elevation >= 800 & elevation < 1000 ~ "800-1000m",
    elevation >= 1000 & elevation < 1200 ~ "1000-1200m",
    elevation >= 1200 & elevation < 1400 ~ "1200-1400m",
    elevation >= 1400 & elevation < 1600 ~ "1400-1600m",
    elevation >= 1600 & elevation < 1800 ~ "1600-1800m",
    elevation >= 1800 & elevation < 2000 ~ "1800-2000m",
    elevation >= 2000 ~ ">2000m"
  )
}

