# Monitoring duration by season
camera_info
library(dplyr)
library(lubridate)
library(purrr)
camera_processed <- camera_info %>%
  # Ensure columns are standard Date objects
  mutate(across(c(Install, Check1, Check2, Check3), as.Date)) %>%
  
  # Determine the final 'Recollect' date
  # coalesce finds the first non-NA value starting from Check3 backwards
  mutate(Recollect = coalesce(Check3, Check2, Check1)) %>%
  
  # Calculate durations by expanding the date range
  mutate(season_counts = map2(Install, Recollect, function(start, end) {
    
    # Valid check: ensure dates exist
    if(is.na(start) | is.na(end) | end <= start) {
      return(data.frame(Warm_Days = 0, Cold_Days = 0))
    }
    
    # Create sequence of active days 
    # NOTE: We use (end - 1) to calculate "Camera Nights" (standard standard ecology).
    # If you want inclusive calendar days, remove the "- 1".
    active_dates <- seq(from = start, to = end - 1, by = "day")
    
    # Extract months (1-12)
    m <- month(active_dates)
    
    # Count based on month definition
    # Warm: May(5) - Sep(9)
    # Cold: Oct(10) - Apr(4)
    warm_count <- sum(m %in% 5:9)
    cold_count <- sum(m %in% c(10, 11, 12, 1, 2, 3, 4))
    
    return(data.frame(Warm_Days = warm_count, Cold_Days = cold_count))
  })) %>%
  
  # Unnest the counts back into main columns
  tidyr::unnest(season_counts)

