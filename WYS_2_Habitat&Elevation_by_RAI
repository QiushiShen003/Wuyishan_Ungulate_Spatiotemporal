```{r}
library(readxl)
camera_info <- read_excel("Camera_Info_12_4.xlsx")
data <- read_excel("wys_data_12_3.xlsx")

library(dplyr)
camera_info <- camera_info %>% 
  filter(Site %in% data$Site)
camera_info

library(tidyr)
consistency_check <- data %>%
  group_by(Site) %>%
  summarise(
    long_consist = n_distinct(Longitude) == 1,
    lat_consist = n_distinct(Latitude) == 1,
    True_long = ifelse(n_distinct(Longitude) == 1, first(Longitude), NA),
    True_lat = ifelse(n_distinct(Latitude) == 1, first(Latitude), NA),
    count = n(),
    .groups = 'drop'
  )

inconsistent_points <- consistency_check %>%
  filter(!long_consist | !lat_consist)

if (nrow(inconsistent_points) > 0) {
  print("Warning: The following site IDs have inconsistent longitude/latitude values:")
  print(inconsistent_points)
  
  # View specific coordinate discrepancies for these sites
  print("Detailed data for inconsistent sites:")
  problematic_details <- data %>%
    filter(Site %in% inconsistent_points$Site) %>%
    arrange(Site)
  print(problematic_details)
  
  # Stop execution or choose handling strategy
  stop("Inconsistent coordinates detected across sites. Please resolve data quality issues first.")
} else {
  print("Check passed: Coordinates across all site IDs are completely consistent.")
}

