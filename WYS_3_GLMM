# Spatial Thinning
```{r}
library(sf)
library(dplyr)

spatial_thinning <- function(df, threshold = 10) {
  # 1. Convert to sf object to calculate exact great-circle distances
  df_sf <- st_as_sf(df, coords = c("Longitude", "Latitude"), crs = 4326)
  
  # 2. Calculate distance matrix
  dist_matrix <- st_distance(df_sf)
  diag(dist_matrix) <- NA # Exclude diagonal self-distances (0)
  
  # Check for camera pairs below distance threshold
  too_close <- which(dist_matrix < units::set_units(threshold, "m"), arr.ind = TRUE)
  
  if(nrow(too_close) == 0) {
    message("All inter-camera distances exceed the threshold; no thinning needed.")
    # Return sorted by Site if no thinning is required
    return(df[order(df$Site), ])
  }
  
  # 3. Greedy randomized thinning algorithm
  keep_sites <- c()
  remaining_sites <- 1:nrow(df)
  
  set.seed(123) # Ensure reproducibility
  
  while(length(remaining_sites) > 0) {
    # Avoid single-element sampling issue in R base sample()
    if (length(remaining_sites) == 1) {
      pick <- remaining_sites
    } else {
      pick <- sample(remaining_sites, 1)
    }
    
    # Retain selected camera
    keep_sites <- c(keep_sites, pick)
    
    # Identify all neighbors within distance threshold
    neighbors <- which(dist_matrix[pick, ] < units::set_units(threshold, "m"))
    
    # Remove current camera and adjacent neighbors from candidate pool
    to_remove <- c(pick, neighbors)
    remaining_sites <- setdiff(remaining_sites, to_remove)
  }
  
  # 4. Subset retained spatially independent cameras
  df_thinned <- df[keep_sites, ]
  
  # 5. Reorder output dataframe by Site
  df_thinned <- df_thinned[order(df_thinned$Site), ]
  
  return(df_thinned)
}

# === Execute thinning ===
# Thin cameras spaced < 10 meters apart
camera_info_thinned <- spatial_thinning(camera_info, threshold = 10)

# Print summary to verify output
cat(sprintf("Spatial thinning complete: Original sites = %d, Retained sites = %d\n", 
            nrow(camera_info), nrow(camera_info_thinned)))

camera_info_thinned

```

# Prepare Data for Modeling
```{r}
# Format and merge data
all_species <- unique(data$Species)
all_sites <- unique(camera_info_thinned$Site)

skeleton <- expand.grid(Species = all_species, Site = all_sites)

counts <- data %>% group_by(Species, Site) %>%
  summarise(Count = n(), .groups = "drop")

data_glm <- skeleton %>% left_join(counts, by = c("Species","Site"))%>%
  mutate(Count = replace_na(Count,0)) %>%
  left_join(camera_info, by = "Site")
```
# Spatial Autocorrelation Test
```{r}
library(DHARMa) # For evaluating GLMM residuals
library(spdep)  # For spatial analysis

sim_res <- simulateResiduals(fittedModel = model_glmm1)
# Aggregate residuals by site
# group parameter must match the Site variable in the model
sim_res_grouped <- recalculateResiduals(sim_res, group = data_glm$Site)

# Step 2: Ensure coordinate order matches aggregated residuals
# aggregate() sorts by Site alphanumeric order, matching recalculateResiduals default behavior
site_locations <- aggregate(cbind(Longitude, Latitude) ~ Site, 
                           data = data_glm, 
                           FUN = mean)

# Step 3: Run spatial autocorrelation test (Moran's I)
testSpatialAutocorrelation(simulationOutput = sim_res_grouped, 
                           x = site_locations$Longitude, 
                           y = site_locations$Latitude)

```

