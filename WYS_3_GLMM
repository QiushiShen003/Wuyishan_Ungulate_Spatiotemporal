# Data Import and 3D Distance Calculation
```{r}
library(dplyr)
library(ggplot2)
library(DHARMa)
library(readxl)
library(tidyverse)
camera_info <- read_excel("Camera_info_12_4.xlsx")
#data <- read_excel("wys_data_12_3.xlsx")

library(sf)
camera_info_sf <- st_as_sf(camera_info, 
                   coords = c("Longitude", "Latitude"), 
                   crs = 4326)
dist_matrix_2d <- st_distance(camera_info_sf)
dist_matrix_2d <- as.numeric(dist_matrix_2d) 
dim(dist_matrix_2d) <- c(nrow(camera_info), nrow(camera_info))

elev_matrix <- outer(camera_info$Elevation, camera_info$Elevation, FUN = function(x, y) abs(x - y))
dist_matrix_3d <- sqrt(dist_matrix_2d^2 + elev_matrix^2)

diag(dist_matrix_3d) <- NA
camera_info$nearest_dist_3d_m <- apply(dist_matrix_3d, 1, min, na.rm = TRUE)
camera_info$nearest_dist_3d_km <- camera_info$nearest_dist_3d_m / 1000

mean_3d <- mean(camera_info$nearest_dist_3d_m, na.rm = TRUE)

min(camera_info$nearest_dist_3d_m)
max(camera_info$nearest_dist_3d_m)

ggplot(camera_info, aes(x = "All Cameras", y = nearest_dist_3d_m)) +
  # Draw boxplot
  geom_boxplot(fill = "#56B4E9", color = "black", width = 0.4, outlier.shape = NA) +
  # Add jitter points to visualize individual camera distributions without overlap
  geom_jitter(width = 0.1, alpha = 0.6, color = "#E69F00", size = 2) +
  theme_bw() +
  labs(
    title = "Nearest Neighbor Distance Among Cameras",
