# Input data standardized on wys_data_12_3.xlsx
# Overlap Index (Asymmetric)
```{r}
library(readxl)
camera_info <- read_excel("Camera_Info_12_4.xlsx")
#data <- read_excel("wys_data_12_3.xlsx")

# Create dataframe
library(dplyr)
library(tidyr)
library(lubridate)
library(purrr)
library(stringr)

# --- Step 1: Process Data & Identify Co-occurrences ---
# 5.12 modified Time to time_adjusted generated by wys_1
# 1. Basic cleaning and time extraction
cleaned_data <- data %>%
  mutate(Hour = hour(time_adjusted)) %>%
  # Remove duplicate records of the same species in the same site-hour 
  # (we only care about presence/absence per hour)
  distinct(Site, Hour, Species)

# 2. Group by Site-Hour to find the "Community" at that moment
# This creates a list of all species present in that specific hour
site_hour_communities <- cleaned_data %>%
  group_by(Site, Hour) %>%
  summarise(
    Community_List = list(sort(unique(Species))), 
    .groups = "drop"
  )

# 3. "Explode" the data to analyze each species as a "Focal" species
# If a Site-Hour has species A, B, and C:
# Row 1: Focal=A, Partner=B+C
# Row 2: Focal=B, Partner=A+C
# Row 3: Focal=C, Partner=A+B
analysis_data <- site_hour_communities %>%
  mutate(Interactions = map(Community_List, function(comm) {
    # For every species in this community, define who they are with
    map_dfr(comm, function(focal) {
      others <- setdiff(comm, focal)
      
      if (length(others) == 0) {
        return(data.frame(Focal = focal, Category = "Solo", Count_Others = 0))
      } else {
        # Create a specific string for the combination (e.g., "SpeciesB + SpeciesC")
        # Sorting ensures "B+C" and "C+B" are treated as the same category
        cat_name <- paste(sort(others), collapse = " + ")
        return(data.frame(Focal = focal, Category = cat_name, Count_Others = length(others)))
      }
    })
  })) %>%
  unnest(Interactions)

# --- Step 2: Define Bootstrapping Function ---

# This function calculates the proportion of EACH unique category found in the vector
calc_category_proportions <- function(category_vector, all_possible_categories) {
  # Count occurrences of each category
  counts <- table(factor(category_vector, levels = all_possible_categories))
  # Return proportions
  return(as.numeric(counts) / length(category_vector))
}

# --- Step 3: Run Bootstrap ---

set.seed(123)
n_boot <- 1000

results <- analysis_data %>%
  group_by(Focal = Focal) %>%
  group_modify(~ {
    # 1. Get the observed vector of interaction categories for this focal species
    obs_categories <- .x$Category
    
    # Define the universe of categories seen for this species (for consistent table mapping)
    unique_cats <- sort(unique(obs_categories))
    
    # 2. Bootstrap Loop
    boot_dist <- replicate(n_boot, {
      # Resample the categories (e.g., sample from ["Solo", "Solo", "SpeciesB", "SpeciesB+C"...])
      resampled <- sample(obs_categories, length(obs_categories), replace = TRUE)
      calc_category_proportions(resampled, unique_cats)
    })
    
    # 3. Calculate CIs
    # boot_dist is a matrix: Rows = Categories, Columns = Iterations
    ci_lower <- apply(boot_dist, 1, quantile, probs = 0.025)
    ci_upper <- apply(boot_dist, 1, quantile, probs = 0.975)
    
    # Calculate observed proportions
    observed_props <- calc_category_proportions(obs_categories, unique_cats)
    
    # 4. Determine "Type" for easier filtering later (Solo vs Pair vs Triplet)
    # We count how many '+' signs are in the category name to guess the count
    others_count <- ifelse(unique_cats == "Solo", 0, str_count(unique_cats, "\\+") + 1)
    
    # 5. Create Summary Table
    data.frame(
      Interaction_Category = unique_cats,
      Others_Count = others_count,
      Proportion = observed_props,
      CI_Lower = ci_lower,
      CI_Upper = ci_upper,
      Total_Occurrences_a = length(obs_categories)
    )
  }) %>%
  ungroup()

# --- Step 4: Filter & View ---

# The user asked specifically for Solo (b), With 1 specific (c), and With 2 specific (d)
# We filter out cases with 3 or more partners to keep the table readable
final_output <- results %>%
  arrange(Focal, Others_Count, Interaction_Category)

print(final_output)

library(writexl)
write_xlsx(final_output, "spatial_temporal_overlap_5_12.xlsx")

```

# Asymmetric Overlap - Rarefaction Sensitivity Test
```{r}
# --- Rarefaction Sensitivity Test ---

# 1. Identify minimum total site-hours across all species (N_min)
species_counts <- analysis_data %>%
  group_by(Focal) %>%
  summarise(Total_N = n(), .groups = "drop")

N_min <- min(species_counts$Total_N)
print(paste("rarest species sample size:", N_min))

# 2. Define rarefaction function
n_rarefaction <- 1000

rarefaction_results <- analysis_data %>%
  group_by(Focal) %>%
  group_modify(~ {
    obs_categories <- .x$Category
    unique_cats <- sort(unique(obs_categories))
    
    # Rarefaction loop: subsample N_min observations without replacement
    rare_dist <- replicate(n_rarefaction, {
      # Note: size = N_min, replace = FALSE (subsampling without replacement)
      subsampled <- sample(obs_categories, size = N_min, replace = FALSE)
      calc_category_proportions(subsampled, unique_cats)
    })
    
    # Calculate rarefied mean and 95% confidence intervals
    rare_mean <- rowMeans(rare_dist)
    rare_ci_lower <- apply(rare_dist, 1, quantile, probs = 0.025)
    rare_ci_upper <- apply(rare_dist, 1, quantile, probs = 0.975)
    
    # Extract observed proportions for comparison
    observed_props <- calc_category_proportions(obs_categories, unique_cats)
    
    data.frame(
      Interaction_Category = unique_cats,
      Original_Proportion = observed_props,
      Rarefied_Mean = rare_mean,       # Rarefied mean
