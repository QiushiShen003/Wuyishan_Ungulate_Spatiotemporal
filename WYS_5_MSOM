# Calculate Levins' Niche Breadth
```{r}
# Define Levins' niche breadth function: B = 1 / sum(p_i^2)
# where p_i is the relative occupancy probability of a species in habitat i
calc_niche_breadth <- function(out, spec_idx) {
  # Extract beta_hab parameters across habitats for target species
  # Note: Approximated via beta_hab logits; full prediction via psi recommended
  hab_effects <- out$mean$beta_hab[spec_idx, ]
  psi_hab <- exp(hab_effects) / (1 + exp(hab_effects)) # Convert logit to probability
  p_relative <- psi_hab / sum(psi_hab)
  B <- 1 / sum(p_relative^2)
  return(B / length(hab_effects)) # Standardize to 0–1 scale
}

# Calculate niche breadth for four species
niche_widths <- sapply(1:4, function(i) calc_niche_breadth(out, i))
names(niche_widths) <- species_names
print(niche_widths)
