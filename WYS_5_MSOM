# Bayesian Multi-Species Occupancy Model Definition (JAGS)
```{r}
library(jagsUI)
cat("
model {
  # ==========================================
  # 1. Community Hyperparameters and Prior Distributions
  # ==========================================
  # Occupancy hyperparameters
  mu_alpha_psi ~ dnorm(0, 0.1)
  tau_alpha_psi ~ dgamma(0.1, 0.1)
  
  mu_beta_elev ~ dnorm(0, 0.1)
  tau_beta_elev ~ dgamma(0.1, 0.1)
  
  # Habitat effect hyperparameters (mean for each category)
  for(h in 1:n_habitats){
    mu_beta_hab[h] ~ dnorm(0, 0.1)
    tau_beta_hab[h] ~ dgamma(0.1, 0.1)
  }
  
  # Detection probability hyperparameters
  mu_alpha_p ~ dnorm(0, 0.1)
  tau_alpha_p ~ dgamma(0.1, 0.1)
  
  # Year effect and spatial random effect precision
  tau_year ~ dgamma(0.1, 0.1)
  tau_spatial ~ dgamma(0.1, 0.1)
  
  # Spatial decay parameter (for distance matrix)
  rho ~ dunif(0, 5) 

  # ==========================================
  # 2. Species-specific Parameters
  # ==========================================
  for (i in 1:n_species) {
    alpha_psi[i] ~ dnorm(mu_alpha_psi, tau_alpha_psi)
    beta_elev[i] ~ dnorm(mu_beta_elev, tau_beta_elev)
    alpha_p[i]   ~ dnorm(mu_alpha_p, tau_alpha_p)
    
    # Habitat effects: species-specific preference for each habitat type
    for(h in 1:n_habitats){
      beta_hab[i, h] ~ dnorm(mu_beta_hab[h], tau_beta_hab[h])
    }

    # Year effects: annual occupancy fluctuations per species
    for (t in 1:n_years) {
      year_effect[i, t] ~ dnorm(0, tau_year) 
    }
  }

  # ==========================================
  # 3. Spatial Random Effect
  # ==========================================
  for(j in 1:n_sites){
    # S[j] represents spatial error for site j
    S[j] ~ dnorm(0, tau_spatial) 
  }

  # ==========================================
  # 4. State Process and Observation Process (Hierarchical Formulation)
  # ==========================================
  for (i in 1:n_species) {
    for (j in 1:n_sites) {
      for (t in 1:n_years) { 
        
        # --- State Equation ---
        logit(psi[i,j,t]) <- alpha_psi[i] + 
                             beta_elev[i] * elevation[j] + 
                             beta_hab[i, habitat[j]] + 
                             S[j] + 
                             year_effect[i,t]
        
        # True latent occupancy state
        z[i,j,t] ~ dbern(psi[i,j,t]) 
        
        # --- Observation Equation ---
        for (k in 1:n_occasions) {
          logit(p_obs[i,j,t,k]) <- alpha_p[i]
          # Observed detection 0/1 conditional on z and p
          y[i,j,t,k] ~ dbern(z[i,j,t] * p_obs[i,j,t,k]) 
        }
      }
    }
  }

  # ==========================================
  # 5. Derived Quantities
  # ==========================================
  # Calculate annual summary metrics per species for manuscript tables
  for (i in 1:n_species) {
    for (t in 1:n_years) {
      # Estimated number of occupied sites per species and year
      # Sum of true latent states z across all sampled sites
      n_occupied[i, t] <- sum(z[i, 1:n_sites, t])
      
      # Mean occupancy probability across sampled sites
      # Average psi across all sampled sites
      mean_psi[i, t] <- mean(psi[i, 1:n_sites, t])
    }
  }
}
", file = "multi_session_spatial_msom.txt")

```


# Fit Bayesian Occupancy Model in JAGS
```{r}
library(rjags)
# --- Step A: Package Data ---
# Ensure elevation_scaled and y_array are prepared
jags_data <- list(
  y = y_array,
  n_species = dim(y_array)[1],
  n_sites = dim(y_array)[2],
  n_years = dim(y_array)[3],
  n_occasions = dim(y_array)[4],
  
  elevation = elevation_scaled,    # Standardized elevation vector
  habitat = habitat_vector,        # Habitat index vector
  n_habitats = n_habitats,         # Total number of habitat categories
  dist_matrix = dist_matrix        # N x N distance matrix
)

# Recommended: run pilot run with smaller n.iter when testing spatial random effects

# --- Step B: Set Initial Values ---
# If y = 1 (detected) while initial z = 0 (unoccupied), JAGS will produce an error.
# Solution: Initialize latent matrix z to 1 across all dimensions.
z_init <- array(1, dim = c(jags_data$n_species, jags_data$n_sites, jags_data$n_years))
inits <- function() {
  list(z = z_init, alpha_psi = rnorm(jags_data$n_species))
}

# --- Step C: Specify Monitored Parameters ---
params_to_save <- c("alpha_psi",    # Baseline occupancy intercepts
                    "beta_elev",    # Elevation coefficients
                    "beta_hab",     # Habitat coefficients
                    "year_effect",  # Year effects
                    "S",            # Spatial/site random effects
                    "alpha_p",      # Detection probabilities
                    "n_occupied", 
                    "mean_psi"
                    )

# --- Step D: Execute MCMC Sampling ---
# Multi-species 4D model is computationally intensive; parallel = TRUE is recommended
# Test run with n.iter = 1000; production runs typically require 30000-50000 iterations
cat("Starting MCMC sampling in JAGS...\n")
out <- jags(data = jags_data,
            inits = inits,
            parameters.to.save = params_to_save,
            model.file = "multi_session_spatial_msom.txt",
            n.chains = 3,       # Run 3 parallel Markov chains
            n.iter = 1000,      # Total MCMC iterations
            n.burnin = 50,      # Burn-in iterations
            n.thin = 5,         # Thinning rate to reduce autocorrelation
            parallel = TRUE)    # Multi-core parallel computing

out <- jags(data = jags_data,
            inits = inits,
            parameters.to.save = params_to_save,
            model.file = "multi_session_spatial_msom.txt",
            n.chains = 3,       # Run 3 parallel Markov chains
            n.iter = 50000,     # Total MCMC iterations
            n.burnin = 5000,    # Burn-in iterations
            n.thin = 5,         # Thinning rate to reduce autocorrelation
            parallel = TRUE) 
# --- Step E: Inspect Model Results ---
print(out)

# Check convergence (R-hat values)
# R-hat < 1.1 indicates satisfactory chain convergence.
jagsUI::traceplot(out, parameters = "beta_elev")
jagsUI::traceplot(out, parameters = "beta_hab")

