n_occ_sims <- out$sims.list$n_occupied 

# 2. Compute inter-annual average per species across posterior iterations
# Average over the 3rd dimension (years) to obtain mean performance per iteration
spec_overall_n_occ <- apply(n_occ_sims, c(1, 2), mean) 
spec_overall_psi <- apply(out$sims.list$mean_psi, c(1, 2), mean)

# 3. Calculate summary statistics (mean and 95% credible intervals)
get_summary <- function(sim_matrix, metric_name) {
  data.frame(
    Species_ID = 1:4,
    Metric = metric_name,
    Mean = apply(sim_matrix, 2, mean),
    Lower = apply(sim_matrix, 2, quantile, probs = 0.025),
    Upper = apply(sim_matrix, 2, quantile, probs = 0.975)
  )
}

overall_summary <- rbind(
  get_summary(spec_overall_n_occ, "Overall_n_occupied"),
  get_summary(spec_overall_psi, "Overall_mean_psi")
)

# 4. Map species names
species_names <- c(
  "1" = "Elaphodus cephalophus", 
  "2" = "Muntiacus reevesi", 
  "3" = "Sus scrofa", 
  "4" = "Capricornis milneedwardsii"
)
overall_summary$Species <- species_names[as.character(overall_summary$Species_ID)]

# 5. Print final formatted summary table
final_concise_report <- overall_summary %>%
  select(Species, Metric, Mean, Lower, Upper) %>%
  arrange(desc(Metric), desc(Mean))

print(final_concise_report)
write_xlsx(final_concise_report, "Occupancy_Metrics_merge_year.xlsx")
