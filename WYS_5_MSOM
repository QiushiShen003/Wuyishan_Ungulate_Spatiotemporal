```{r}
# 2. Convert raw detections to detection histories using camtrapR
target_species <- c("Elaphodus cephalophus", "Muntiacus reevesi", "Sus scrofa", "Capricornis milneedwardsii")

all_sites <- rownames(cam_op_matrix) 

dh_list_4d <- list()

for (sp in target_species) {
  dh_list_4d[[sp]] <- list() 
  
  for (yr in target_years) {
    # 1. Extract camera matrix for the year
    camOp_yr <- cam_op_matrix_list[[yr]]
    
    # 2. Identify active cameras with >= 1 operational day in that year
    # rowSums(!is.na()) > 0 indicates non-NA active records
    valid_stations <- rownames(camOp_yr)[rowSums(!is.na(camOp_yr)) > 0]
    
    # 3. Subset operation matrix and detections for active cameras
    camOp_yr_valid <- camOp_yr[valid_stations, , drop = FALSE]
    
    # Extract year from PtTime and filter records to active cameras
    data_yr <- subset(data, format(as.POSIXct(PtTime), "%Y") == yr & Site %in% valid_stations)
    
    # 4. Generate detection history
    dh <- detectionHistory(recordTable = data_yr,
                           camOp = camOp_yr_valid,
                           stationCol = "Site",
                           speciesCol = "Species",
                           species = sp, 
                           recordDateTimeCol = "PtTime",
                           occasionLength = 7,
                           day1 = "survey")
                           
    dh_matrix <- dh$detection_history
    
    # 5. Pad matrix to include all camera stations across full array
    full_matrix <- matrix(NA, 
                          nrow = length(all_sites), 
                          ncol = ncol(dh_matrix),
                          dimnames = list(all_sites, colnames(dh_matrix)))
    
    # Populate template matrix with active camera records
    full_matrix[rownames(dh_matrix), ] <- dh_matrix
    
    # Store in list
    dh_list_4d[[sp]][[yr]] <- full_matrix
  }
}
