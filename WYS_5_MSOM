# Set fixed coordinates for the study area
study_longitude <- 117.7  # Longitude: 117.7° E
study_latitude <- 27.7    # Latitude: 27.7° N

# Define function to calculate equation of time
equation_of_time <- function(date) {
    # Calculate day of the year
    J <- as.numeric(format(date, "%j"))
    
    # Calculate equation of time (minutes)
    B <- 2 * pi * (J - 81) / 365
    Et <- 9.87 * sin(2*B) - 7.53 * cos(B) - 1.5 * sin(B)
    
    return(Et)
}

# Define conversion function
convert_to_solar_time <- function(Time) {
    # Ensure input is POSIXct format
    datetime <- as.POSIXct(Time)
    
    # Timezone offset (China is UTC+8)
    timezone_offset <- 8
    
    # Calculate longitude time difference (4 minutes per degree)
    longitude_time_diff <- (study_longitude - (timezone_offset * 15)) * 4 / 60
    
    # Calculate equation of time correction (hours)
    et <- equation_of_time(as.Date(Time)) / 60
    
    # Convert time to decimal hours
    hour <- as.numeric(format(Time, "%H"))
    minute <- as.numeric(format(Time, "%M"))
    second <- as.numeric(format(Time, "%S"))
    
    time_in_hours <- hour + minute/60 + second/3600
    
    # Calculate apparent solar time
    solar_time <- time_in_hours + longitude_time_diff + et
    
    # Handle values exceeding 24 or below 0
    solar_time <- solar_time %% 24
    
    return(solar_time)
}

